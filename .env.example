# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Supabase project (Settings > API). The publishable/anon key is public by design: RLS protects the data.
# Do NOT put the service_role / secret key anywhere in this app; nothing needs it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SECRET. Encrypts postcodes before they reach the database. Generate with: openssl rand -base64 32
# Losing it makes saved postcodes unreadable; rotating it needs a re-encryption step.
SCENARIO_ENCRYPTION_KEY=

# Public URL of the deployed site, used for email links and the HTTPS redirect.
SITE_URL=https://pawprint-ledger.example

# Optional bot protection: Cloudflare Turnstile site key (public). Put the matching SECRET key
# in Supabase (Authentication > Attack Protection > CAPTCHA), not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: Overpass mirror for the vet search.
OVERPASS_URL=
